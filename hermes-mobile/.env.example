# Opt-in to authentication only against an isolated test environment. Leave unset for the G0 offline demo.
EXPO_PUBLIC_MOBILE_AUTH_MODE=staging
EXPO_PUBLIC_CRM_AUTH_BASE_URL=https://otp-staging.example.invalid
EXPO_PUBLIC_HERMES_API_BASE_URL=https://hermes-staging.example.invalid
# Optional: replace fictitious post-login demo with read-only Inbox from an isolated G4 integration backend.
# EXPO_PUBLIC_MOBILE_INBOX_MODE=read-only
# Never put OTP, proofs, refresh tokens, secrets or credentials in EXPO_PUBLIC_* variables.
