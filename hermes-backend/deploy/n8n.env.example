# Example only. Codex VPS must provision the real file outside Git with mode 0600.
# Verify that the pinned running n8n version still consumes the BASIC_AUTH fields.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=replace-with-the-existing-user-before-rotation
N8N_BASIC_AUTH_PASSWORD=replace-during-the-coordinated-vps-rotation

# Must match the backend N8N_HMAC_SECRET after the coordinated rotation.
N8N_HMAC_SECRET=replace-during-the-coordinated-vps-rotation

# Intentionally absent: N8N_ENCRYPTION_KEY. Preserve the current n8n data volume
# and its existing encryption key; do not generate or replace it in this change.
