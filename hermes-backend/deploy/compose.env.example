# Docker Compose interpolation only. Keep the real file outside Git with mode 0600.
HERMES_BACKEND_ENV_FILE=/etc/hermes-crm/backend.env
POSTGRES_ENV_FILE=/etc/hermes-crm/postgres.env
N8N_ENV_FILE=/etc/hermes-crm/n8n.env

# Codex VPS must replace this with the digest of the image currently running.
# Do not use latest during the credential migration.
N8N_IMAGE=n8nio/n8n@sha256:replace-with-current-running-digest
