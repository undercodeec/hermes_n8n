// Hermes Backend - Prisma Schema
// Sistema completo de CRM conversacional para ventas por WhatsApp

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES_AGENT
  VIEWER
}

enum MarketingConsentStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  SKIPPED
}

enum AdvertisingProvider {
  GOOGLE_ADS
}

enum AdvertisingAttributionStatus {
  UNCONFIRMED
  CONFIRMED
  EXPIRED
  REVOKED
}

enum AdvertisingConsentChoice {
  UNSPECIFIED
  GRANTED
  DENIED
}

enum AdvertisingEventType {
  WHATSAPP_CLICK
  CONVERSATION_STARTED
  LEAD_QUALIFIED
  MEETING_CONFIRMED
  PROPOSAL_SENT
  CONTRACT_WON
  CONTRACT_LOST
}

enum AdvertisingSyncStatus {
  NOT_ELIGIBLE
  PENDING
  QUEUED
  VALIDATED
  SUBMITTED
  ACCEPTED
  PARTIAL
  RETRYING
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(SALES_AGENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  assignedHandoffs HumanHandoff[] @relation("AssignedAgent")
  assignedTasks    Task[]         @relation("AssignedUser")
  sentMessages     Message[]      @relation("HumanSender")
  auditLogs        AuditLog[]
  createdCampaigns Campaign[]     @relation("CampaignCreator")

  @@map("users")
}

// ─────────────────────────────────────────────
// Contacts & Leads
// ─────────────────────────────────────────────

model Contact {
  id                     String                 @id @default(uuid())
  waId                   String                 @unique // WhatsApp ID (número de teléfono)
  phone                  String?
  name                   String?
  email                  String?
  company                String?
  position               String? // Cargo
  notes                  String?
  metadata               Json? // Datos extra flexibles
  marketingConsentStatus MarketingConsentStatus @default(UNKNOWN)
  marketingConsentAt     DateTime?
  marketingConsentSource String?
  marketingOptOutAt      DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // Relaciones
  leads                   Lead[]
  conversations           Conversation[]
  messages                Message[]
  campaignRecipients      CampaignRecipient[]
  advertisingAttributions AdvertisingAttribution[]
  advertisingConversions  AdvertisingConversion[]
  automatedDeliveries     AutomatedDelivery[]

  @@map("contacts")
}

model Campaign {
  id                 String         @id @default(uuid())
  name               String
  templateName       String
  templateLanguage   String
  templateCategory   String?
  templateMetaId     String?
  templateHeaderType String?
  headerVideoMediaId String?
  headerVideoUrl     String?
  headerVideoAssetId String?
  status             CampaignStatus @default(DRAFT)
  totalRecipients    Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  pausedAt           DateTime?
  createdByUserId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  createdBy        User?               @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  headerVideoAsset CampaignMedia?      @relation(fields: [headerVideoAssetId], references: [id], onDelete: Restrict)
  recipients       CampaignRecipient[]

  @@index([status, createdAt])
  @@map("campaigns")
}

// A Media ID is not a secret. Keeping it here lets operators choose an
// already-uploaded WhatsApp video without copying IDs or changing .env.
model CampaignMedia {
  id              String   @id @default(uuid())
  name            String
  metaMediaId     String   @unique
  mimeType        String
  sizeBytes       Int
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaigns                   Campaign[]
  templateMediaConfigurations CampaignTemplateMedia[]

  @@index([createdAt])
  @@map("campaign_media")
}

model CampaignTemplateMedia {
  id               String   @id @default(uuid())
  wabaId           String
  metaTemplateId   String?
  templateName     String
  templateLanguage String
  headerType       String
  campaignMediaId  String?
  mediaUrl         String?
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaignMedia CampaignMedia? @relation(fields: [campaignMediaId], references: [id], onDelete: Restrict)

  @@unique([wabaId, templateName, templateLanguage, headerType])
  @@index([metaTemplateId])
  @@map("campaign_template_media")
}

model CampaignRecipient {
  id              String                  @id @default(uuid())
  campaignId      String
  contactId       String
  phone           String
  status          CampaignRecipientStatus @default(PENDING)
  wamid           String?                 @unique
  sendAttemptedAt DateTime?
  metaTimestamp   DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  repliedAt       DateTime?
  failedAt        DateTime?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId, createdAt])
  @@map("campaign_recipients")
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Lead {
  id                 String    @id @default(uuid())
  contactId          String
  conversationId     String?   @unique
  stage              LeadStage @default(NEW)
  score              Int       @default(0)
  productOfInterest  String?
  estimatedBudget    Float?
  serviceRequested   String?
  proposalValue      Decimal?  @db.Decimal(18, 2)
  contractedAmount   Decimal?  @db.Decimal(18, 2)
  revenueReceived    Decimal?  @db.Decimal(18, 2)
  commercialCurrency String?   @db.VarChar(3)
  contractReference  String?
  commercialOwnerId  String?
  lastObjection      String?
  nextAction         String?
  closeProbability   Float? // 0.0 a 1.0
  lostReason         String?
  wonAt              DateTime?
  lostAt             DateTime?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relaciones
  contact                 Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation            Conversation?            @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  tasks                   Task[]
  campaignSource          CampaignSource?          @relation(fields: [campaignSourceId], references: [id])
  campaignSourceId        String?
  advertisingAttributions AdvertisingAttribution[]
  advertisingConversions  AdvertisingConversion[]

  @@index([contactId, createdAt])
  @@index([stage, updatedAt])
  @@map("leads")
}

// ─────────────────────────────────────────────
// Conversations & Messages
// ─────────────────────────────────────────────

enum ConversationStatus {
  ACTIVE
  PAUSED
  HANDED_OFF
  CLOSED
}

model Conversation {
  id        String             @id @default(uuid())
  contactId String
  status    ConversationStatus @default(ACTIVE)
  channel   String             @default("whatsapp")
  metadata  Json?
  closedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Relaciones
  contact                 Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages                Message[]
  state                   ConversationState?
  lead                    Lead?
  handoffs                HumanHandoff[]
  tasks                   Task[]
  advertisingAttributions AdvertisingAttribution[]
  automatedDeliveries     AutomatedDelivery[]

  @@index([contactId, updatedAt])
  @@index([status, updatedAt])
  @@map("conversations")
}

model ConversationState {
  id                  String   @id @default(uuid())
  conversationId      String   @unique
  summary             String? // Resumen corto de la conversación
  detectedIntent      String? // Intención detectada
  nextSuggestedAction String? // Próxima acción sugerida
  detectedRisks       String? // Riesgos detectados
  commercialTags      Json? // Etiquetas comerciales (array de strings)
  closeScore          Float? // Puntaje de probabilidad de cierre
  leadStage           String? // Etapa del lead según la conversación
  lastObjection       String? // Última objeción detectada
  updatedAt           DateTime @updatedAt

  // Relaciones
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_states")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  INTERACTIVE
  REACTION
  STICKER
  LOCATION
  UNKNOWN
}

enum MessageSender {
  CONTACT
  HERMES
  HUMAN
  SYSTEM
}

enum AutomatedDeliveryKind {
  HERMES_REPLY
  SYSTEM_NOTICE
}

enum AutomatedDeliveryStatus {
  PREPARED
  DISPATCHING
  CONFIRMED
  REJECTED
  AMBIGUOUS
  SUPPRESSED
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  contactId      String
  direction      MessageDirection
  sender         MessageSender    @default(SYSTEM)
  sentByUserId   String?
  type           MessageType      @default(TEXT)
  content        String? // Contenido del mensaje
  rawPayload     Json? // Payload crudo de Meta
  wamid          String?          @unique // WhatsApp Message ID
  tokensUsed     Int? // Tokens consumidos por Hermes
  latencyMs      Int? // Latencia en ms de la respuesta
  costEstimate   Float? // Costo estimado en USD
  metadata       Json?
  createdAt      DateTime         @default(now())

  // Relaciones
  conversation              Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact                   Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sentByUser                User?                   @relation("HumanSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  advertisingAttribution    AdvertisingAttribution?
  sourceAutomatedDeliveries AutomatedDelivery[]     @relation("AutomatedDeliverySource")
  outboundAutomatedDelivery AutomatedDelivery?      @relation("AutomatedDeliveryOutbound")

  @@index([conversationId, createdAt])
  @@index([contactId])
  @@index([sentByUserId])
  @@map("messages")
}

model AutomatedDelivery {
  id                String                  @id @default(uuid())
  operationKey      String                  @unique
  deliveryKind      AutomatedDeliveryKind
  partIndex         Int
  conversationId    String
  contactId         String
  sourceMessageId   String
  outboundMessageId String?                 @unique
  sender            MessageSender
  content           String
  allowHandedOff    Boolean                 @default(false)
  status            AutomatedDeliveryStatus @default(PREPARED)
  attempts          Int                     @default(0)
  claimToken        String?
  claimExpiresAt    DateTime?
  dispatchStartedAt DateTime?
  confirmedAt       DateTime?
  ambiguousAt       DateTime?
  rejectedAt        DateTime?
  suppressedAt      DateTime?
  wamid             String?                 @unique
  reasonCode        String?
  metadata          Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sourceMessage   Message      @relation("AutomatedDeliverySource", fields: [sourceMessageId], references: [id], onDelete: Restrict)
  outboundMessage Message?     @relation("AutomatedDeliveryOutbound", fields: [outboundMessageId], references: [id], onDelete: SetNull)

  @@unique([sourceMessageId, deliveryKind, partIndex])
  @@index([status, claimExpiresAt])
  @@index([conversationId, createdAt])
  @@map("automated_deliveries")
}

// ─────────────────────────────────────────────
// Products & Pricing
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  serviceCode String?
  sku         String?  @unique
  imageUrl    String?
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  priceLists PriceList[]

  @@index([serviceCode, isActive])
  @@map("products")
}

model PriceList {
  id                    String               @id @default(uuid())
  productId             String
  name                  String
  price                 Decimal?             @db.Decimal(12, 2)
  currency              String               @default("USD")
  /// Null means this is the global price policy, shared by every market.
  market                CommercialMarket?
  priceType             CommercialPriceType?
  taxMode               CommercialTaxMode?
  taxLabel              String?
  taxRatePercent        Decimal?             @db.Decimal(5, 2)
  scope                 String?
  policyVersion         String?
  isPromotion           Boolean              @default(false)
  supersedesPriceListId String?
  validFrom             DateTime             @default(now())
  validUntil            DateTime?
  restrictions          String? // Restricciones o condiciones
  notes                 String?
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  // Relaciones
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([market, isActive, validFrom, validUntil])
  @@map("price_lists")
}

enum CommercialMarket {
  EC
  ES
}

enum CommercialPriceType {
  FIXED
  FROM
  QUOTE_REQUIRED
}

enum CommercialTaxMode {
  INCLUDED
  EXCLUDED
  NOT_APPLICABLE
}

// ─────────────────────────────────────────────
// Knowledge & Playbooks
// ─────────────────────────────────────────────

enum DocumentType {
  FAQ
  POLICY
  CATALOG
  GUIDE
  TERMS
  PRICING
  GENERAL
}

model KnowledgeDocument {
  id        String       @id @default(uuid())
  title     String
  content   String // Contenido completo del documento
  type      DocumentType @default(GENERAL)
  version   Int          @default(1)
  tags      Json? // Array de tags para búsqueda
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("knowledge_documents")
}

enum PlaybookType {
  OPENING
  OBJECTION_HANDLING
  CLOSING
  FOLLOW_UP
  UPSELL
  CROSS_SELL
  REACTIVATION
  GENERAL
}

model SalesPlaybook {
  id        String       @id @default(uuid())
  title     String
  content   String // Contenido del guión
  type      PlaybookType @default(GENERAL)
  triggers  Json? // Condiciones para activar el playbook
  priority  Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("sales_playbooks")
}

// ─────────────────────────────────────────────
// Tasks & Handoff
// ─────────────────────────────────────────────

enum TaskType {
  FOLLOW_UP
  APPOINTMENT
  CALLBACK
  QUOTE
  DEMO
  GENERAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id             String     @id @default(uuid())
  leadId         String?
  conversationId String?
  assignedUserId String?
  type           TaskType   @default(GENERAL)
  status         TaskStatus @default(PENDING)
  title          String
  description    String?
  dueAt          DateTime?
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relaciones
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedUser User?         @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

enum HandoffReason {
  SUPPORT
  SPECIAL_DISCOUNT
  COMPLAINT
  COMPLEX_QUOTE
  B2B_NEGOTIATION
  FRUSTRATED_USER
  REPEATED_NO_PROGRESS
  INFO_ERROR
  PAYMENT_ISSUE
  CUSTOM
}

enum HandoffStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model HumanHandoff {
  id              String        @id @default(uuid())
  conversationId  String
  reason          HandoffReason @default(CUSTOM)
  reasonDetail    String?
  status          HandoffStatus @default(PENDING)
  assignedAgentId String?
  resolution      String?
  resolvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relaciones
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedAgent User?        @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  @@index([conversationId, status])
  @@index([status, createdAt])
  @@map("human_handoffs")
}

// ─────────────────────────────────────────────
// Campaigns & Ads
// ─────────────────────────────────────────────

model CampaignSource {
  id           String   @id @default(uuid())
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  landingPage  String?
  entryChannel String?  @default("whatsapp")
  firstMessage String? // Primer mensaje del contacto
  metadata     Json?
  createdAt    DateTime @default(now())

  // Relaciones
  leads       Lead[]
  adsMetadata AdsMetadata[]

  @@map("campaign_sources")
}

model AdsMetadata {
  id               String   @id @default(uuid())
  campaignSourceId String
  adId             String? // Meta Ad ID
  adsetId          String? // Meta Adset ID
  campaignId       String? // Meta Campaign ID
  adName           String?
  spend            Float? // Gasto del anuncio
  impressions      Int?
  clicks           Int?
  currency         String?  @default("USD")
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  campaignSource CampaignSource @relation(fields: [campaignSourceId], references: [id], onDelete: Cascade)

  @@map("ads_metadata")
}

// ─────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────

// Publicidad de adquisicion. Estas entidades son independientes de las
// campanas masivas de WhatsApp y no almacenan conversaciones completas.
model AdvertisingIntegration {
  id                    String              @id @default(uuid())
  provider              AdvertisingProvider @unique
  conversionSyncEnabled Boolean             @default(false)
  metricsSyncEnabled    Boolean             @default(false)
  accountId             String?
  loginAccountId        String?
  accountCurrency       String?             @db.VarChar(3)
  accountTimeZone       String?
  lastMetricsSyncAt     DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  mappings     AdvertisingConversionMapping[]
  dailyMetrics AdvertisingDailyMetric[]

  @@map("advertising_integrations")
}

model AdvertisingTouch {
  id                String                   @id @default(uuid())
  provider          AdvertisingProvider      @default(GOOGLE_ADS)
  channel           String                   @default("paid_search")
  source            String                   @default("google")
  referenceHash     String                   @unique @db.VarChar(64)
  referenceLast4    String                   @db.VarChar(4)
  expiresAt         DateTime
  consumedAt        DateTime?
  useCount          Int                      @default(0)
  maxUses           Int                      @default(1)
  gclid             String?
  gbraid            String?
  wbraid            String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  landingPage       String?
  visitedAt         DateTime                 @default(now())
  adStorage         AdvertisingConsentChoice @default(UNSPECIFIED)
  analyticsStorage  AdvertisingConsentChoice @default(UNSPECIFIED)
  adUserData        AdvertisingConsentChoice @default(UNSPECIFIED)
  adPersonalization AdvertisingConsentChoice @default(UNSPECIFIED)
  consentSource     String?
  consentRecordedAt DateTime?
  metadata          Json?
  createdAt         DateTime                 @default(now())

  attributions AdvertisingAttribution[]
  conversions  AdvertisingConversion[]

  @@index([expiresAt, consumedAt])
  @@index([gclid])
  @@index([gbraid])
  @@index([wbraid])
  @@index([utmCampaign, createdAt])
  @@map("advertising_touches")
}

model AdvertisingAttribution {
  id               String                       @id @default(uuid())
  touchId          String
  contactId        String?
  leadId           String?
  conversationId   String?
  inboundMessageId String?                      @unique
  status           AdvertisingAttributionStatus @default(UNCONFIRMED)
  attributedAt     DateTime?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  touch          AdvertisingTouch        @relation(fields: [touchId], references: [id], onDelete: Cascade)
  contact        Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead           Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversation   Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  inboundMessage Message?                @relation(fields: [inboundMessageId], references: [id], onDelete: SetNull)
  conversions    AdvertisingConversion[]

  @@unique([touchId, contactId])
  @@index([contactId, attributedAt])
  @@index([leadId, attributedAt])
  @@index([status, createdAt])
  @@map("advertising_attributions")
}

model AdvertisingConversion {
  id                  String               @id @default(uuid())
  idempotencyKey      String               @unique
  eventType           AdvertisingEventType
  attributionId       String?
  touchId             String?
  contactId           String?
  leadId              String?
  occurredAt          DateTime
  source              String
  verified            Boolean              @default(false)
  verifiedByUserId    String?
  value               Decimal?             @db.Decimal(18, 2)
  currency            String?              @db.VarChar(3)
  commercialReference String?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  attribution AdvertisingAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  touch       AdvertisingTouch?       @relation(fields: [touchId], references: [id], onDelete: SetNull)
  contact     Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  syncJob     AdvertisingSyncJob?

  @@unique([leadId, eventType])
  @@index([eventType, occurredAt])
  @@index([touchId, occurredAt])
  @@map("advertising_conversions")
}

model AdvertisingConversionMapping {
  id                 String               @id @default(uuid())
  integrationId      String
  eventType          AdvertisingEventType @unique
  conversionActionId String
  exportEnabled      Boolean              @default(false)
  isPrimary          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  integration AdvertisingIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, exportEnabled])
  @@map("advertising_conversion_mappings")
}

model AdvertisingSyncJob {
  id              String                @id @default(uuid())
  conversionId    String                @unique
  status          AdvertisingSyncStatus @default(PENDING)
  attempts        Int                   @default(0)
  validateOnly    Boolean               @default(true)
  googleRequestId String?
  warnings        Json?
  errorCode       String?
  errorMessage    String?
  nextAttemptAt   DateTime?
  submittedAt     DateTime?
  diagnosedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  conversion AdvertisingConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([googleRequestId])
  @@map("advertising_sync_jobs")
}

model AdvertisingDailyMetric {
  id              String   @id @default(uuid())
  integrationId   String
  campaignId      String
  campaignName    String
  campaignStatus  String
  metricDate      DateTime @db.Date
  impressions     BigInt
  clicks          BigInt
  costMicros      BigInt
  currency        String   @db.VarChar(3)
  accountTimeZone String
  syncedAt        DateTime @default(now())

  integration AdvertisingIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, campaignId, metricDate])
  @@index([metricDate, campaignStatus])
  @@map("advertising_daily_metrics")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // e.g. "UPDATE_PLAYBOOK", "CREATE_PRODUCT", "HANDOFF_CREATED"
  entity    String // e.g. "products", "playbooks", "leads"
  entityId  String?
  changes   Json? // { before: {...}, after: {...} }
  ipAddress String?
  createdAt DateTime @default(now())

  // Relaciones
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
