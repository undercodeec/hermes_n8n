PORT=3003
NODE_ENV=development

DATABASE_URL=postgresql://hermes_user:change-me@localhost:5432/hermes_db
REDIS_URL=redis://localhost:6379

JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRATION=8h

# Debe coincidir exactamente con CRM_HERMES_PROOF_SECRET del backend Admin.
CRM_HERMES_PROOF_SECRET=generate-a-shared-random-secret-of-at-least-32-characters
CRM_OPERATOR_EMAIL=gerencia@undercodeec.com

# URL pública del módulo CRM, sin barra final.
CRM_BASE_URL=https://admincrm.undercodeec.com
# Lista CSV de orígenes permitidos. Obligatoria en producción.
CORS_ORIGINS=https://admincrm.undercodeec.com

# Server-to-server attribution endpoint used by the UnderCodeEC backend. Never
# expose either value in browser JavaScript. Use independent random secrets.
AD_ATTRIBUTION_INTEGRATION_KEY=generate-a-random-secret-of-at-least-32-characters
AD_ATTRIBUTION_REFERENCE_PEPPER=generate-another-random-secret-of-at-least-32-characters
AD_ATTRIBUTION_ALLOWED_ORIGINS=https://undercodeec.com
AD_ATTRIBUTION_REFERENCE_TTL_MINUTES=10080
AD_ATTRIBUTION_RATE_LIMIT_PER_MINUTE=30

# Google integrations are fail-closed and disabled until a controlled test.
# ADC is preferred; GOOGLE_APPLICATION_CREDENTIALS may point to a mounted file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_TIMEOUT_MS=10000
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Los Developer Tokens de Google Ads fueron retirados el 2026-09-09.
# La API determina el acceso mediante el proyecto de las credenciales OAuth/ADC.
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_CURRENCY=EUR
GOOGLE_ADS_TIME_ZONE=Europe/Madrid
ADVERTISING_GOOGLE_SYNC_ENABLED=false
ADVERTISING_GOOGLE_SEND_ENABLED=false
ADVERTISING_GOOGLE_METRICS_ENABLED=false
ADVERTISING_METRICS_SYNC_INTERVAL_MS=21600000
ADVERTISING_GOOGLE_INCLUDE_USER_DATA=false

META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v21.0
META_WABA_ID=

# Official WhatsApp template campaigns remain disabled until a controlled test is authorized.
CAMPAIGNS_ENABLED=false
CAMPAIGN_SEND_RATE_PER_SECOND=2
# Comma-separated HTTPS hosts allowed for optional template video links. Prefer Meta media IDs.
CAMPAIGN_MEDIA_ALLOWED_HOSTS=

HERMES_API_URL=http://localhost:8080/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-default
# Activa JSON Schema nativo cuando el proveedor compatible lo soporte.
HERMES_STRUCTURED_OUTPUT=false
HERMES_TEMPERATURE=0.25
HERMES_MAX_OUTPUT_TOKENS=2048
HERMES_COMPLETION_ATTEMPTS=2
HERMES_RETRY_MAX_OUTPUT_TOKENS=4096
# En Gemini 2.5, low reserva 1.024 tokens de razonamiento. Pro no permite none.
HERMES_REASONING_EFFORT=low
# Tarifas del modelo/despliegue efectivo; revisarlas al cambiar HERMES_MODEL.
# Se dejan en 0 para no registrar costes ficticios en una instalación nueva.
HERMES_INPUT_USD_PER_MILLION_TOKENS=0
HERMES_OUTPUT_USD_PER_MILLION_TOKENS=0
HERMES_KNOWLEDGE_LIMIT=12
HERMES_PRODUCT_LIMIT=30
HERMES_PLAYBOOK_LIMIT=10
HERMES_BUSINESS_CONTEXT_MAX_CHARS=18000

# Pausa fija antes de procesar respuestas automáticas por WhatsApp. El tiempo
# total también incluye la latencia real del proveedor de IA y de Meta.
AI_REPLY_DELAY_MS=2000

# Protección previa a Gemini. Redis es obligatorio: con FAIL_CLOSED Hermes no
# consume IA cuando la capa anti-spam no puede verificarse.
AI_GUARD_FAIL_CLOSED=true
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_CHARS=900
AI_CONTACT_MESSAGES_WINDOW_SECONDS=600
AI_CONTACT_MAX_MESSAGES_PER_WINDOW=15
SPAM_COOLDOWN_SECONDS=1800
AI_GUARD_NOTICE_COOLDOWN_SECONDS=1800
AI_CONTACT_DAILY_REPLY_LIMIT=60
AI_GLOBAL_HOURLY_REPLY_LIMIT=500

# Sólo se deriva a este número cuando el cliente reporta un problema técnico y
# afirma explícitamente que el proyecto fue realizado por la marca.
SUPPORT_PHONE_E164=+593979046329

LEAD_QUALIFICATION_INTENTS=consulta_precio,cotizacion,agendar_cita,pago
HANDOFF_INTENTS=solicitud_humano,queja,reclamo,pago_fallido,negociacion_especial,error
HANDOFF_KEYWORDS=hablar con humano,hablar con persona,agente real,quiero quejarme,reclamo,estoy molesto,no funciona,descuento especial,cotización compleja,precio corporativo

N8N_INTEGRATION_ENABLED=false
N8N_BASE_URL=http://localhost:5678
N8N_HMAC_SECRET=generate-another-long-random-secret
N8N_DISPATCH_TIMEOUT_MS=5000
N8N_MAX_RETRIES=5
N8N_WEBHOOK_LEAD_QUALIFIED=/webhook/lead-qualified
N8N_WEBHOOK_HANDOFF_REQUESTED=/webhook/handoff-requested

# Sólo para ejecutar admin:create/admin:create:dev.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Administrador Hermes
