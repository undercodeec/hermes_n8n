# Agregar dentro del bloque HTTPS `server` de undercodeec.com.
# La barra final de ambos paths es intencional:
# /api/hermes/leads -> http://127.0.0.1:3003/api/leads

location = /api/hermes {
    return 308 /api/hermes/;
}

location /api/hermes/ {
    proxy_pass http://127.0.0.1:3003/api/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /api/hermes;

    client_max_body_size 10M;
    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
}
